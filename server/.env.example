# HTTP port for the Express API.
PORT=5000

# Browser origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# JWT signing secret (minimum 32 characters). Generate a new one locally:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# MongoDB Atlas connection string. Never commit the real value.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aptis-go?retryWrites=true&w=majority
MONGODB_URI=

# Connection pool bounds (optional; defaults shown).
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

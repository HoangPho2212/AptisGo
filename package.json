{
  "name": "aptis-go",
  "version": "0.1.0",
  "private": true,
  "description": "APTIS GO — decoupled React client and Express server for Aptis ESOL preparation",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui",
    "lint": "eslint . && npm --prefix client run lint && npm --prefix server run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
